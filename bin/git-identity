#!/bin/zsh
# Check or interactively fix git identity setup.

set -u
setopt extended_glob null_glob

LIB="$HOME/.config/git-identity/lib.sh"
DEFAULT_IGNORE_FILE="$HOME/.config/git-identity/ignore"
LOG_FILE="$HOME/.config/git-identity/migrate.log"

[[ -f "$LIB" ]] || { echo "missing $LIB" >&2; exit 2; }
source "$LIB"

sweep=0; sweep_path=""; fix=0; include_ignored=0
porcelain=0; do_auth=0; dry_run=0; no_ignore=0
ignore_file="$DEFAULT_IGNORE_FILE"

usage() {
  cat <<EOF
Usage: git-identity [OPTIONS]

  (no flags)              Check current repo (detailed)
  --sweep [PATH]          Walk PATH (default: current dir), one line per repo
  --fix                   Interactive fix mode (prompt for each not-OK repo)
  --include-ignored       Also visit ignored repos (revisit mode)
  --porcelain             Tab-separated sweep output
  --auth                  Test SSH auth (single-repo only, slow)
  --dry-run               Show commands without executing
  --ignore-file PATH      Use a custom ignore file
                          (default: $DEFAULT_IGNORE_FILE)
  --no-ignore             Disable ignore filtering
  -h, --help              This help
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sweep)           sweep=1
                       # PATH is optional and defaults to '.'; only consume the
                       # next token when it's a real path, not another flag.
                       if [[ -n "${2:-}" && "$2" != -* ]]; then
                         sweep_path="$2"; shift 2
                       else
                         sweep_path="."; shift
                       fi ;;
    --fix)             fix=1; shift ;;
    --include-ignored) include_ignored=1; shift ;;
    --porcelain)       porcelain=1; shift ;;
    --auth)            do_auth=1; shift ;;
    --dry-run)         dry_run=1; shift ;;
    --ignore-file)     [[ $# -ge 2 ]] || { echo "git-identity: --ignore-file needs a PATH" >&2; exit 2; }
                       ignore_file="$2"; shift 2 ;;
    --no-ignore)       no_ignore=1; shift ;;
    -h|--help)         usage; exit 0 ;;
    *) echo "unknown arg: $1" >&2; usage >&2; exit 2 ;;
  esac
done

typeset -a IGNORES
IGNORES=()
if [[ $no_ignore -eq 0 && -f "$ignore_file" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%\#*}"
    line="${line##[[:space:]]##}"
    line="${line%%[[:space:]]##}"
    [[ -z "$line" ]] && continue
    line="${line/#\~/$HOME}"
    IGNORES+=("$line")
  done < "$ignore_file"
fi

is_ignored() {
  local repo_path="$1" pat
  for pat in "${IGNORES[@]}"; do
    [[ -z "$pat" ]] && continue
    if [[ "$pat" == *[\*\?\[]* ]]; then
      case "$repo_path" in
        ${~pat}) return 0 ;;
      esac
    elif [[ "$pat" == */ ]]; then
      [[ "$repo_path" == "${pat}"* || "$repo_path" == "${pat%/}" ]] && return 0
    else
      [[ "$repo_path" == "$pat" ]] && return 0
    fi
  done
  return 1
}

log_action() {
  mkdir -p "${LOG_FILE:h}"
  printf '[%s] %s: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" "$2" >> "$LOG_FILE"
}

run_cmd() {
  printf '  Will run: %s\n' "$*"
  if [[ $dry_run -eq 1 ]]; then
    printf '  (dry-run) skipped\n'; return 0
  fi
  local confirm
  read -r "confirm?  Confirm? [y/N] "
  case "$confirm" in
    y|Y|yes|YES) ;;
    *) printf '  cancelled\n'; return 1 ;;
  esac
  if "$@"; then
    log_action "$(pwd)" "$*"
    printf '  ✓ done\n'
  else
    printf '  ✗ failed\n'; return 1
  fi
}

oneline_tag_detail() {
  # Owner drift surfaces only when the identity itself is OK; otherwise the
  # identity problem is the headline.
  if [[ "$ID_STATE" == "ok" ]]; then
    case "$ID_OWNER_STATE" in
      drift)   echo "OWNER|${ID_OWNER}→${ID_EXPECTED_OWNER}"; return ;;
      unknown) echo "OWNER?|want ${ID_EXPECTED_OWNER}"; return ;;
    esac
  fi
  case "$ID_STATE" in
    ok)                 echo "OK|${ID_E_ALIAS}" ;;
    mismatch)           echo "MISMATCH|${ID_E_ALIAS}→${ID_H_ALIAS}" ;;
    warn-no-email)      echo "NO-EMAIL|-" ;;
    warn-no-remote)     echo "NO-REMOTE|${ID_E_ALIAS:-$ID_EMAIL}" ;;
    warn-https)         echo "HTTPS|${ID_E_ALIAS:-$ID_EMAIL}" ;;
    warn-unknown-email) echo "UNK-EMAIL|${ID_EMAIL}" ;;
    warn-unknown-host)  echo "UNK-HOST|${ID_HOST}" ;;
    warn-unknown-both)  echo "UNK-BOTH|${ID_EMAIL}/${ID_HOST}" ;;
  esac
}

print_repo_info() {
  local repo="$1"
  echo "Repo:    $repo"
  echo "Email:   ${ID_EMAIL:-(unset)}${ID_E_ALIAS:+  →  <$ID_E_ALIAS>}"
  echo "Remote:  ${ID_REMOTE:-(none)}"
  [[ -n "$ID_HOST" ]] && echo "         host=$ID_HOST${ID_H_ALIAS:+  →  <$ID_H_ALIAS>}"
  [[ -n "$ID_EXPECTED_OWNER" ]] && \
    echo "Owner:   ${ID_OWNER:-(none)}  →  profile expects ${ID_EXPECTED_OWNER}"
}

check_detailed() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "Not inside a git work tree." >&2; return 2; }
  detect_identity
  local repo; repo=$(git rev-parse --show-toplevel)
  print_repo_info "$repo"
  local failed=0
  echo
  case "$ID_STATE" in
    ok)             echo "Status:  ✓ OK — <${ID_E_ALIAS}>" ;;
    warn-no-remote) echo "Status:  ⚠ no origin remote yet" ;;
    *)              echo "Status:  ✗ $ID_STATE"; failed=1 ;;
  esac
  case "$ID_OWNER_STATE" in
    drift)   echo "Owner:   ✗ drift — repo is under '${ID_OWNER}', profile expects '${ID_EXPECTED_OWNER}'"; failed=1 ;;
    unknown) echo "Owner:   ⚠ profile expects '${ID_EXPECTED_OWNER}' but remote owner is unreadable" ;;
  esac
  if [[ $do_auth -eq 1 && -n "$ID_HOST" ]]; then
    echo
    printf 'SSH auth (%s): ' "$ID_HOST"
    if ssh -T -o BatchMode=yes -o ConnectTimeout=5 "$ID_HOST" 2>&1 \
       | grep -q "successfully authenticated"; then echo "✓"
    else echo "✗"; failed=1
    fi
  fi
  return "$failed"
}

add_to_ignore() {
  local default_pat="$1"
  default_pat="${default_pat/#$HOME/~}"
  echo "  Add to ignore. Edit pattern (Enter to accept):"
  local pat="$default_pat"
  vared -p "  > " pat
  [[ -z "$pat" ]] && { echo "  empty, skipping"; return; }
  if [[ $dry_run -eq 1 ]]; then
    echo "  (dry-run) would append '$pat' to $ignore_file"
    IGNORES+=("${pat/#\~/$HOME}")
    return
  fi
  mkdir -p "${ignore_file:h}"
  echo "$pat" >> "$ignore_file"
  IGNORES+=("${pat/#\~/$HOME}")
  log_action "$(pwd)" "ignore: $pat"
  echo "  ✓ Added"
}

remove_from_ignore_for() {
  local target="$1"
  local target_tilde="${target/#$HOME/~}"
  if [[ $dry_run -eq 1 ]]; then
    echo "  (dry-run) would remove '$target'/'$target_tilde' from $ignore_file"
    return
  fi
  local tmp; tmp=$(mktemp)
  while IFS= read -r line || [[ -n "$line" ]]; do
    local clean="${line%%\#*}"
    clean="${clean##[[:space:]]##}"
    clean="${clean%%[[:space:]]##}"
    if [[ "$clean" == "$target" || "$clean" == "$target_tilde" ]]; then
      log_action "$target" "un-ignore (removed: $line)"
      continue
    fi
    echo "$line"
  done < "$ignore_file" > "$tmp"
  mv "$tmp" "$ignore_file"
  echo "  ✓ Removed"
}

prompt_mismatch() {
  local canon_email canon_host rpath a
  canon_email=$(alias_to_email "$ID_H_ALIAS")
  canon_host=$(alias_to_host "$ID_E_ALIAS")
  rpath=$(echo "$ID_REMOTE" | sed -E 's|^git@[^:]+:||')
  echo "Options:"
  echo "  (e) Email → <${ID_H_ALIAS}> canonical: ${canon_email}"
  echo "  (r) Remote → <${ID_E_ALIAS}> canonical: git@${canon_host}:${rpath}"
  echo "  (s) Skip   (i) Ignore   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    e|E) run_cmd git config user.email "$canon_email" ;;
    r|R) run_cmd git remote set-url origin "git@${canon_host}:${rpath}" ;;
    s|S) ;;
    i|I) add_to_ignore "$(pwd)" ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

prompt_pick_email() {
  local a key i=0
  echo "Options:"
  for key in "${ALIASES_ORDERED[@]}"; do
    i=$((i + 1))
    printf '  (%d) %-8s %s\n' "$i" "$key" "${ALIAS_TO_EMAIL[$key]}"
  done
  echo "  (s) Skip   (i) Ignore   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    s|S) ;;
    i|I) add_to_ignore "$(pwd)" ;;
    q|Q) return 2 ;;
    <1->)
      if (( a >= 1 && a <= ${#ALIASES_ORDERED[@]} )); then
        local picked="${ALIASES_ORDERED[$a]}"
        run_cmd git config user.email "${ALIAS_TO_EMAIL[$picked]}"
      else
        echo "  invalid, skipping"
      fi
      ;;
    *) echo "  invalid, skipping" ;;
  esac
}

prompt_unknown_host() {
  local a
  echo "Options:"
  echo "  (i) Ignore (typical for non-GitHub remotes)"
  echo "  (m) Open identities in \$EDITOR to add a mapping"
  echo "  (s) Skip   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    i|I) add_to_ignore "$(pwd)" ;;
    m|M) ${EDITOR:-vi} "$IDENTITIES_FILE" ;;
    s|S) ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

prompt_https() {
  [[ "$ID_REMOTE" =~ ^https://([^/]+)/(.+)$ ]] || { echo "  cannot parse https URL"; return; }
  local host_https="${match[1]}"
  local rpath="${match[2]%.git}"
  local target_host="$host_https"
  local a
  [[ -n "$ID_E_ALIAS" ]] && target_host=$(alias_to_host "$ID_E_ALIAS")
  echo "Options:"
  echo "  (c) Convert to SSH: git@${target_host}:${rpath}.git"
  echo "  (s) Skip   (i) Ignore   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    c|C) run_cmd git remote set-url origin "git@${target_host}:${rpath}.git" ;;
    s|S) ;;
    i|I) add_to_ignore "$(pwd)" ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

prompt_simple() {
  local a
  echo "Options:"
  echo "  (s) Skip   (i) Ignore   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    s|S) ;;
    i|I) add_to_ignore "$(pwd)" ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

# Transfer the repo on GitHub from cur_owner → new_owner using the identity's
# gh-user account (token fetched per-command, never switching gh globally — same
# pattern as gitinit), then repoint origin. Outward-facing and hard to undo, so
# it carries its own explicit confirmation.
transfer_repo_gh() {
  local ghuser="$1" cur_owner="$2" name="$3" new_owner="$4" new_url="$5"
  echo "  This TRANSFERS ${cur_owner}/${name} → ${new_owner} on GitHub (account: $ghuser)."
  echo "  Transfers are hard to undo and need admin on the repo + create rights in '${new_owner}'."
  local confirm; read -r "confirm?  Proceed with transfer? [y/N] "
  case "$confirm" in y|Y|yes|YES) ;; *) printf '  cancelled\n'; return 1 ;; esac

  if [[ $dry_run -eq 1 ]]; then
    printf '  (dry-run) would run: gh api --method POST repos/%s/%s/transfer -f new_owner=%s\n' \
      "$cur_owner" "$name" "$new_owner"
    printf '  (dry-run) would run: git remote set-url origin %s\n' "$new_url"
    return 0
  fi

  local gh_token
  if ! gh_token=$(gh auth token -u "$ghuser" 2>/dev/null) || [[ -z "$gh_token" ]]; then
    printf '  ✗ gh account %s is not authenticated; run: gh auth login\n' "$ghuser"; return 1
  fi
  if ! GH_TOKEN="$gh_token" gh api --method POST \
       "repos/${cur_owner}/${name}/transfer" -f "new_owner=${new_owner}" >/dev/null; then
    printf '  ✗ transfer failed (no admin? or %s/%s already exists?)\n' "$new_owner" "$name"; return 1
  fi
  log_action "$(pwd)" "gh transfer ${cur_owner}/${name} -> ${new_owner}"
  printf '  ✓ transferred\n'
  if git remote set-url origin "$new_url"; then
    log_action "$(pwd)" "git remote set-url origin $new_url"
    printf '  ✓ origin → %s\n' "$new_url"
  else
    printf '  ✗ origin update failed; set it manually: git remote set-url origin %s\n' "$new_url"
  fi
}

# Owner drift: identity is fine but the repo's GitHub owner ≠ the profile owner.
# Offered only for SSH remotes (we rebuild the URL from the aliased host).
prompt_owner_drift() {
  local a repo_name new_url alias_for ghuser can_gh=0
  if [[ -z "$ID_HOST" ]]; then
    echo "  Owner drift on a non-SSH remote — fix the remote manually."
    echo "  (s) Skip   (i) Ignore   (q) Quit"
    read -r "a?Choice: "
    case "$a" in i|I) add_to_ignore "$(pwd)" ;; q|Q) return 2 ;; *) ;; esac
    return
  fi
  repo_name="${ID_REMOTE##*/}"                     # repo or repo.git
  new_url="git@${ID_HOST}:${ID_EXPECTED_OWNER}/${repo_name}"
  alias_for="${ID_E_ALIAS:-$ID_H_ALIAS}"
  ghuser=$(alias_to_ghuser "$alias_for")
  command -v gh >/dev/null 2>&1 && [[ -n "$ghuser" ]] && can_gh=1

  echo "Options:"
  echo "  (l) Local only: repoint origin → ${new_url}"
  echo "      (use if the repo ALREADY lives under '${ID_EXPECTED_OWNER}' on GitHub)"
  if [[ $can_gh -eq 1 ]]; then
    echo "  (t) Transfer on GitHub: ${ID_OWNER}/${repo_name%.git} → ${ID_EXPECTED_OWNER} (as ${ghuser}), then repoint"
  fi
  echo "  (s) Skip   (i) Ignore   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    l|L) run_cmd git remote set-url origin "$new_url" ;;
    t|T)
      if [[ $can_gh -eq 1 ]]; then
        transfer_repo_gh "$ghuser" "$ID_OWNER" "${repo_name%.git}" "$ID_EXPECTED_OWNER" "$new_url"
      else
        echo "  gh unavailable or alias '${alias_for}' has no gh-user; skipping"
      fi
      ;;
    s|S) ;;
    i|I) add_to_ignore "$(pwd)" ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

fix_repo_interactive() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  detect_identity
  # Nothing to do when identity is OK and there's no owner drift.
  [[ "$ID_STATE" == "ok" && "$ID_OWNER_STATE" != "drift" ]] && return 0
  local repo; repo=$(git rev-parse --show-toplevel)
  echo
  echo "─────────────────────────────────────────────────────────────"
  print_repo_info "$repo"
  echo "State:   $ID_STATE${ID_OWNER_STATE:+ / owner:$ID_OWNER_STATE}"
  echo
  case "$ID_STATE" in
    ok)                    prompt_owner_drift ;;   # identity fine, owner drifted
    mismatch)              prompt_mismatch ;;
    warn-unknown-email|warn-no-email) prompt_pick_email ;;
    warn-unknown-host)     prompt_unknown_host ;;
    warn-https)            prompt_https ;;
    warn-no-remote|warn-unknown-both) prompt_simple ;;
  esac
}

revisit_ignored() {
  local a
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  detect_identity 2>/dev/null || true
  local repo; repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  echo
  echo "─────────────────────────────────────────────────────────────"
  print_repo_info "$repo"
  echo "State:   $ID_STATE (currently ignored)"
  echo "Options:"
  echo "  (k) Keep ignored"
  echo "  (u) Un-ignore (will be processed normally next time)"
  echo "  (s) Skip   (q) Quit"
  read -r "a?Choice: "
  case "$a" in
    k|K|s|S) ;;
    u|U) remove_from_ignore_for "$repo" ;;
    q|Q) return 2 ;;
    *) echo "  invalid, skipping" ;;
  esac
}

sweep_check() {
  local sweep_dir="$1"
  [[ -d "$sweep_dir" ]] || { echo "not a directory: $sweep_dir" >&2; return 2; }
  local total=0 bad=0 ignored=0 repo td tag detail gitpath
  local -a found
  found=( ${(0)"$(/usr/bin/find "$sweep_dir" -name .git -prune -print0)"} )
  for gitpath in "${found[@]}"; do
    [[ -z "$gitpath" ]] && continue
    repo="${gitpath:h}"
    total=$((total + 1))
    if is_ignored "$repo"; then
      ignored=$((ignored + 1))
      if [[ $include_ignored -eq 1 ]]; then
        if [[ $porcelain -eq 1 ]]; then
          printf 'ignored\t-\t%s\n' "$repo"
        else
          printf '[%-9s] %-28s %s\n' "IGNORED" "-" "$repo"
        fi
      fi
      continue
    fi
    detect_identity "$repo"
    td=$(oneline_tag_detail)
    tag=${td%%|*}; detail=${td#*|}
    # Owner drift is reported even when identity is OK; reflect it in the
    # porcelain state column and the needs-attention tally.
    local state_out="$ID_STATE"
    if [[ "$ID_STATE" == "ok" && "$ID_OWNER_STATE" != "ok" ]]; then
      state_out="owner-$ID_OWNER_STATE"
    fi
    if [[ $porcelain -eq 1 ]]; then
      printf '%s\t%s\t%s\n' "$state_out" "$detail" "$repo"
    else
      printf '[%-9s] %-28s %s\n' "$tag" "$detail" "$repo"
    fi
    [[ "$state_out" == "ok" ]] || bad=$((bad + 1))
  done
  if [[ $porcelain -eq 0 ]]; then
    echo
    echo "Total: $total   Needs attention: $bad   Ignored: $ignored"
  fi
  [[ $bad -eq 0 ]]
}

sweep_fix() {
  local sweep_dir="$1"
  [[ -d "$sweep_dir" ]] || { echo "not a directory: $sweep_dir" >&2; return 2; }
  local -a found repos
  found=( ${(0)"$(/usr/bin/find "$sweep_dir" -name .git -prune -print0)"} )
  for gitpath in "${found[@]}"; do
    [[ -z "$gitpath" ]] && continue
    repos+=("${gitpath:h}")
  done
  local total=${#repos[@]} idx=0 rc=0 repo
  for repo in "${repos[@]}"; do
    idx=$((idx + 1))
    pushd "$repo" >/dev/null 2>&1 || continue
    if is_ignored "$repo"; then
      if [[ $include_ignored -eq 1 ]]; then
        printf '\n[%d/%d]' "$idx" "$total"
        revisit_ignored; rc=$?
        popd >/dev/null
        [[ $rc -eq 2 ]] && { echo; echo "Quitting."; break; }
      else
        popd >/dev/null
      fi
    else
      if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        popd >/dev/null; continue
      fi
      detect_identity
      if [[ "$ID_STATE" != "ok" || "$ID_OWNER_STATE" == "drift" ]]; then
        printf '\n[%d/%d]' "$idx" "$total"
        fix_repo_interactive; rc=$?
        popd >/dev/null
        [[ $rc -eq 2 ]] && { echo; echo "Quitting."; break; }
      else
        popd >/dev/null
      fi
    fi
  done
}

if [[ $sweep -eq 1 ]]; then
  if [[ $fix -eq 1 ]]; then sweep_fix "$sweep_path"
  else sweep_check "$sweep_path"
  fi
else
  if [[ $fix -eq 1 ]]; then
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
      echo "Not inside a git work tree." >&2; exit 2; }
    fix_repo_interactive
  else
    check_detailed
  fi
fi
