#!/bin/zsh
# gitclone — clone a repo with the correct git identity applied.
#
# Usage:
#   gitclone [--profile <alias>] <url> [target-dir] [git clone flags...]
#
# Alias resolution priority:
#   1. --profile <alias>
#   2. URL's SSH host if it's an aliased host (e.g. github-liotru)
#   3. profiles file matched against $PWD
#   4. None → passes through to plain git clone
#
# When an alias is resolved:
#   - URL host is rewritten to the alias's canonical host (if needed)
#   - HTTPS URLs are converted to SSH
#   - After clone, user.email is set to canonical for the alias
#
# GIT_IDENTITY_DEBUG=1 prints what the wrapper decided/did.

set -u

LIB="$HOME/.config/git-identity/lib.sh"

[[ -f "$LIB" ]] || { echo "missing $LIB" >&2; exit 2; }
source "$LIB"

debug() { [[ "${GIT_IDENTITY_DEBUG:-}" == "1" ]] && echo "# gitclone: $*" >&2; return 0 }

usage() {
  cat <<EOF
Usage: gitclone [--profile <alias>] <url> [target-dir] [git clone flags...]

Alias resolution priority:
  1. --profile <alias>
  2. URL's SSH host if it's an aliased host (e.g. github-liotru)
  3. profiles file matched against \$PWD
  4. None → passes through to plain git clone

GIT_IDENTITY_DEBUG=1 shows what was decided.
EOF
  exit "${1:-0}"
}

# Profile lookup (match_profile, sets pf_alias / pf_owner) comes from lib.sh.

# ----- Parse our --profile flag -----
forced_alias=""
typeset -a args
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile) [[ $# -ge 2 ]] || { echo "gitclone: --profile needs an alias" >&2; usage 2; }
               forced_alias="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    *) args+=("$1"); shift ;;
  esac
done
[[ ${#args[@]} -eq 0 ]] && { echo "gitclone: no URL given" >&2; usage 2; }
if [[ -n "$forced_alias" && -z "$(alias_to_host "$forced_alias")" ]]; then
  echo "gitclone: unknown profile '$forced_alias'" >&2; exit 2
fi

# Find URL
url=""; url_idx=0
for i in {1..${#args[@]}}; do
  case "${args[$i]}" in
    git@*:*|https://*|ssh://*|git://*) url="${args[$i]}"; url_idx=$i; break ;;
  esac
done
[[ -z "$url" ]] && { echo "gitclone: no URL found" >&2; exit 2; }

# Resolve alias
alias=""; alias_from_profile=0
if [[ -n "$forced_alias" ]]; then
  alias="$forced_alias"; debug "alias from --profile: $alias"
else
  ssh_host=$(parse_remote_host "$url")
  if [[ -n "$ssh_host" && "$ssh_host" != "github.com" ]]; then
    derived=$(host_to_alias "$ssh_host")
    if [[ -n "$derived" ]]; then alias="$derived"; debug "alias from URL host: $alias"; fi
  fi
  if [[ -z "$alias" ]]; then
    match_profile "$(pwd)"
    [[ -n "$pf_alias" ]] && { alias="$pf_alias"; alias_from_profile=1; debug "alias from profile: $alias"; }
  fi
fi

if [[ -z "$alias" ]]; then
  debug "no profile matched — pass-through"
  exec git clone "${args[@]}"
fi

# Rewrite URL host if needed
target_host=$(alias_to_host "$alias")
new_url="$url"
if [[ "$url" =~ ^git@([^:]+):(.+)$ ]]; then
  current_host="${match[1]}"
  rpath="${match[2]}"
  [[ "$current_host" != "$target_host" ]] && new_url="git@${target_host}:${rpath}"
elif [[ "$url" =~ ^https://([^/]+)/(.+)$ ]]; then
  rpath="${match[2]}"
  [[ "$rpath" != *.git ]] && rpath="${rpath}.git"
  new_url="git@${target_host}:${rpath}"
fi
[[ "$new_url" != "$url" ]] && { debug "URL rewritten: $url → $new_url"; args[$url_idx]="$new_url"; }

# Target dir
target_dir=""
if (( url_idx + 1 <= ${#args[@]} )); then
  next="${args[$((url_idx + 1))]}"
  [[ "$next" != -* ]] && target_dir="$next"
fi
[[ -z "$target_dir" ]] && target_dir="${new_url:t:r}"

# Flag when the identity came only from the catch-all profile (likely not what
# you want for a fresh clone in this directory).
if [[ $alias_from_profile -eq 1 && -n "$pf_pattern" && "$pf_pattern" == "$(last_profile_pattern)" ]]; then
  print "gitclone: ⚠ only the catch-all profile ('$pf_pattern') matched ${PWD/#$HOME/~} — set a specific rule if this is wrong:"
  print "          git-identity --add-profile '${PWD/#$HOME/~}/**' ${alias} <owner>"
fi

debug "running: git clone ${args[*]}"
git clone "${args[@]}" || exit $?

canon_email=$(alias_to_email "$alias")
if [[ -n "$canon_email" ]] && git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  debug "setting user.email=$canon_email in $target_dir"
  git -C "$target_dir" config user.email "$canon_email"
fi
