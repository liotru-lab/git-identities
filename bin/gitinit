#!/bin/zsh
# gitinit — init a new repo with the correct identity, branches, and remote,
#           then create it on GitHub and push. (Use gitclone for existing repos.)
#
# Usage:
#   gitinit [--profile <alias>] [--owner <org/user>] [--remote <url>] [--public]
#           [-s|--simple] [-y|--yes] [--no-create] [--no-remote] [--no-branches]
#           [git-init-flags...] [directory]
#
# Default flow:
#   1. git init -b main
#   2. set user.email from alias
#   3. create README.md with "# <basename>" and commit it
#   4. create test and develop branches; switch to develop
#   5. add origin and configure develop to track origin/develop
#   6. create the GitHub repo (via gh) and push develop, main, test
#
# With -s/--simple steps 4-6 use main only: no test/develop branches, stay on
# main, track origin/main, and push only main.
#
# In an existing, non-empty folder it creates + pushes the repo (asks once,
# unless -y/--yes): with a .gitignore your tracked files are committed too;
# without one only a README is, and your code is left for you to commit. A
# folder that is already a git repo is refused.
#
# Creating the GitHub repo (step 6, on by default) needs a gh-user (4th
# identities column) for the alias and that account authenticated in gh. The
# repo is created under the resolved owner, private unless --public.
#
# Owner resolution (who the repo is created/pushed under):
#   with --remote URL     → taken from that URL
#   else --owner <o>      → explicit
#   else profile match    → the rule's owner column
#   else                  → the alias's own gh-user namespace
#
# URL resolution for the remote:
#   --remote URL          → use as-is (with host rewrite by alias)
#   else                  → git@<host(alias)>:<owner>/<basename>.git
#   --no-remote           → skip remote setup entirely
#
# Flags:
#   --owner <org/user>  create/push under this owner (else profile, else gh-user)
#   -s, --simple   main only: skip the test/develop branches, stay on main,
#                  track origin/main, push only main
#   -y, --yes      skip the confirmation prompt when adopting an existing folder
#   --no-create    do everything locally (incl. origin) but DON'T create the
#                  GitHub repo or push — the old default for an existing remote
#   --no-remote    skip remote setup entirely (no origin; implies --no-create)
#   --no-branches  just init + email (implies --no-create)
#   --public       make the created repo public (default: private)
#
# GIT_IDENTITY_DEBUG=1 shows what was decided.

set -u

LIB="$HOME/.config/git-identity/lib.sh"

[[ -f "$LIB" ]] || { echo "missing $LIB" >&2; exit 2; }
source "$LIB"

debug() { [[ "${GIT_IDENTITY_DEBUG:-}" == "1" ]] && echo "# gitinit: $*" >&2; return 0 }

# Printed when an existing folder had no .gitignore, so only the README was
# committed and the user's code was left for them to commit manually.
adopt_warning() {
  (( adopt_warn )) || return 0
  print ""
  print "gitinit: ⚠ no .gitignore — your existing files were NOT committed (README only)."
  print "  add a .gitignore, then commit and push them:"
  print "    git -C $target_dir add -A && git -C $target_dir commit -m \"add project files\" && git -C $target_dir push"
}

# match_profile (sets pf_alias / pf_owner) comes from lib.sh.

# ----- Parse flags -----
# create defaults ON: gitinit is for NEW repos (use gitclone for existing ones).
forced_alias=""; forced_remote_url=""; forced_owner=""; no_remote=0; no_branches=0
create=1; public=0; no_create=0; simple=0; assume_yes=0; adopt_warn=0
typeset -a args
args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)      [[ $# -ge 2 ]] || { echo "gitinit: --profile needs an alias" >&2; exit 2; }
                    forced_alias="$2"; shift 2 ;;
    --remote)       [[ $# -ge 2 ]] || { echo "gitinit: --remote needs a URL" >&2; exit 2; }
                    forced_remote_url="$2"; shift 2 ;;
    --owner)        [[ $# -ge 2 ]] || { echo "gitinit: --owner needs an org/user" >&2; exit 2; }
                    forced_owner="$2"; shift 2 ;;
    -s|--simple)    simple=1; shift ;;
    -y|--yes)       assume_yes=1; shift ;;
    --no-remote)    no_remote=1; shift ;;
    --no-branches)  no_branches=1; shift ;;
    --no-create)    no_create=1; shift ;;
    --public)       public=1; shift ;;
    -h|--help)
      sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) args+=("$1"); shift ;;
  esac
done

if [[ -n "$forced_alias" && -z "$(alias_to_host "$forced_alias")" ]]; then
  echo "gitinit: unknown profile '$forced_alias'" >&2; exit 2
fi

# Creating the GitHub repo requires an origin to push to and commits to push, so
# --no-create / --no-remote / --no-branches all turn it off.
[[ $no_create -eq 1 || $no_remote -eq 1 || $no_branches -eq 1 ]] && create=0

if [[ $public -eq 1 && $create -eq 0 ]]; then
  echo "gitinit: --public has no effect without creating a repo (dropped by --no-create/--no-remote/--no-branches)" >&2
  exit 2
fi

if [[ $create -eq 1 ]] && ! command -v gh >/dev/null 2>&1; then
  echo "gitinit: creating the GitHub repo needs the gh CLI (https://cli.github.com); install it or pass --no-create" >&2
  exit 2
fi

# ----- Target dir -----
target_dir=""
for arg in "${args[@]}"; do
  case "$arg" in
    -*) ;;
    *)  target_dir="$arg" ;;
  esac
done
# gitinit's argument is a folder name, not a clone URL. A URL-shaped arg would
# create a directory literally named after the URL (and then confuse a later
# `git clone`), so reject it and point at gitclone instead.
case "$target_dir" in
  *://*|*@*:*)
    echo "gitinit: '$target_dir' looks like a URL — gitinit takes a folder name, not a clone URL." >&2
    echo "         To clone an existing repo, use: gitclone $target_dir" >&2
    exit 2 ;;
esac
[[ -z "$target_dir" ]] && target_dir="$(pwd)"
abs_target="$target_dir"
case "$abs_target" in
  /*) ;;
  *)  abs_target="$(pwd)/$abs_target" ;;
esac

# ----- Resolve alias + owner -----
# Owner precedence: --owner  >  profile owner  >  the alias's own gh-user
# namespace. That last fallback makes `gitinit --profile <alias> <dir>` create
# under your own account with no profile and no --remote needed.
match_profile "$abs_target"
alias=""; owner=""
if [[ -n "$forced_alias" ]]; then
  alias="$forced_alias"
  [[ "$pf_alias" == "$alias" ]] && owner="$pf_owner"
else
  alias="$pf_alias"
  owner="$pf_owner"
fi
if [[ -n "$forced_owner" ]]; then
  owner="$forced_owner"
elif [[ -z "$owner" && -n "$alias" ]]; then
  owner="$(alias_to_ghuser "$alias")"
fi
debug "alias=$alias owner=$owner"

repo_name="${abs_target:t}"

# Scope guard: gitinit is for NEW repos. Refuse a folder that's already a repo
# (adopting an existing repo's history/remote is a separate flow).
if [[ -e "$target_dir/.git" ]]; then
  echo "gitinit: '$target_dir' is already a git repo — gitinit is for new repos." >&2
  echo "         use 'git-identity --fix' for its identity/owner, or wire the remote manually." >&2
  exit 2
fi

# Is this an existing, non-empty folder (vs. a fresh/empty one)?
had_content=0
[[ -d "$target_dir" && -n "$(ls -A -- "$target_dir" 2>/dev/null)" ]] && had_content=1

# Turning an existing folder into a repo creates + pushes a GitHub repo — confirm
# once (unless --yes). Skipped for empty/new folders and for local-only runs
# (--no-create/--no-remote/--no-branches set create=0).
if [[ $had_content -eq 1 && $create -eq 1 && $assume_yes -eq 0 ]]; then
  if [[ -f "$target_dir/.gitignore" ]]; then
    incl="its tracked files (respecting .gitignore)"
  else
    incl="a README only — your code is NOT committed (no .gitignore)"
  fi
  print "gitinit: create a repo for existing folder '${target_dir}' and push?"
  print "  identity <${alias}>, owner ${owner} → ${repo_name}; initial commit: ${incl}"
  read -r "reply?Proceed? [y/N] "
  case "$reply" in
    y|Y|yes|YES) ;;
    *) echo "gitinit: cancelled — folder untouched" >&2; exit 1 ;;
  esac
fi

# ----- Force -b main into init args if not already present -----
has_b=0
for arg in "${args[@]}"; do
  [[ "$arg" == "-b" || "$arg" == "--initial-branch"* ]] && has_b=1
done
typeset -a init_args
if [[ $has_b -eq 0 ]]; then
  init_args=( -b main "${args[@]}" )
else
  init_args=( "${args[@]}" )
fi

# ----- Run init -----
debug "git init ${init_args[*]}"
git init "${init_args[@]}" || exit $?

# ----- Set user.email -----
canon_email=""
if [[ -n "$alias" ]]; then
  canon_email=$(alias_to_email "$alias")
  if [[ -n "$canon_email" ]] && git -C "$target_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    debug "user.email=$canon_email"
    git -C "$target_dir" config user.email "$canon_email"
  fi
fi

# ----- --no-branches: stop here -----
if [[ $no_branches -eq 1 ]]; then
  debug "--no-branches: stopping after init + email"
  exit 0
fi

# ----- README + initial commit -----
readme="$target_dir/README.md"
if [[ ! -f "$readme" ]]; then
  printf '# %s\n\n' "$repo_name" > "$readme"
  debug "created $readme"
fi
# An existing folder WITH a .gitignore gets its tracked files committed; without
# one (or an empty/new folder) only the README goes in — and for an existing
# folder we flag the skipped content afterward (adopt_warn).
if [[ $had_content -eq 1 && -f "$target_dir/.gitignore" ]]; then
  git -C "$target_dir" add -A
  debug "staged all content (.gitignore present)"
else
  git -C "$target_dir" add README.md
  [[ $had_content -eq 1 ]] && adopt_warn=1
fi
git -C "$target_dir" commit -m "initial commit" >/dev/null

# ----- Branches -----
# Default: scaffold test + develop and work on develop. --simple: main only.
if [[ $simple -eq 1 ]]; then
  track_branch=main
  debug "--simple: main only (no test/develop)"
else
  track_branch=develop
  git -C "$target_dir" branch test
  git -C "$target_dir" branch develop
  git -C "$target_dir" checkout develop >/dev/null 2>&1
  debug "created branches main, test, develop (on develop)"
fi

# ----- --no-remote: stop here -----
if [[ $no_remote -eq 1 ]]; then
  debug "--no-remote: skipping remote setup"
  adopt_warning
  exit 0
fi

# ----- Build URL -----
remote_url=""
if [[ -n "$forced_remote_url" ]]; then
  remote_url="$forced_remote_url"
  if [[ -n "$alias" ]] && [[ "$remote_url" =~ ^git@([^:]+):(.+)$ ]]; then
    target_host=$(alias_to_host "$alias")
    [[ "${match[1]}" != "$target_host" ]] && remote_url="git@${target_host}:${match[2]}"
  fi
  # Keep the GitHub create target consistent with the explicit URL.
  owner="$(parse_remote_owner "$remote_url")"
elif [[ -n "$alias" && -n "$owner" ]]; then
  remote_url="git@$(alias_to_host "$alias"):${owner}/${repo_name}.git"
fi

if [[ -z "$remote_url" ]]; then
  echo "gitinit: cannot determine remote URL (alias='$alias' owner='$owner'); pass --owner <org/user>, --remote <URL>, or --no-remote" >&2
  exit 2
fi

# Show what was resolved (so a wrong identity/owner is visible before pushing),
# and flag when only the catch-all profile matched — the usual silent mistake.
print "gitinit: identity <${alias}>, owner ${owner} → ${remote_url}"
if [[ -z "$forced_alias$forced_owner$forced_remote_url" \
      && -n "$pf_pattern" && "$pf_pattern" == "$(last_profile_pattern)" ]]; then
  print "gitinit: ⚠ only the catch-all profile ('$pf_pattern') matched — set a specific rule if this is wrong:"
  print "         git-identity --add-profile '${abs_target/#$HOME/~}/**' ${alias} ${owner}"
fi

# ----- Add origin + set tracking -----
debug "git remote add origin $remote_url"
git -C "$target_dir" remote add origin "$remote_url"
git -C "$target_dir" config "branch.${track_branch}.remote" origin
git -C "$target_dir" config "branch.${track_branch}.merge" "refs/heads/${track_branch}"
debug "${track_branch} tracks origin/${track_branch}"

# ----- Create the GitHub repo and push (default; disable with --no-create) -----
if [[ $create -eq 1 ]]; then
  if [[ -z "$alias" ]]; then
    echo "gitinit: creating a repo needs an identity alias (use --profile or a profiles match, or pass --no-create)" >&2
    exit 2
  fi
  ghuser=$(alias_to_ghuser "$alias")
  if [[ -z "$ghuser" ]]; then
    echo "gitinit: alias '$alias' has no gh-user (4th identities column) to create the repo with; add it or pass --no-create" >&2
    exit 2
  fi

  # gh auth token -u fails (non-zero) when that account isn't logged in — this
  # doubles as the auth check. We pass the token per-command via GH_TOKEN so gh
  # is never switched globally.
  gh_token=""
  if ! gh_token=$(gh auth token -u "$ghuser" 2>/dev/null) || [[ -z "$gh_token" ]]; then
    echo "gitinit: gh account '$ghuser' is not authenticated; run: gh auth login" >&2
    exit 2
  fi

  # Create under the profile owner; fall back to the gh-user's own namespace.
  create_owner="${owner:-$ghuser}"
  visibility="--private"
  [[ $public -eq 1 ]] && visibility="--public"

  # --simple pushes main only; default pushes all three branches.
  if [[ $simple -eq 1 ]]; then
    push_branches=(main)
  else
    push_branches=(develop main test)
  fi

  debug "gh repo create ${create_owner}/${repo_name} $visibility (as $ghuser)"
  if ! GH_TOKEN="$gh_token" gh repo create "${create_owner}/${repo_name}" $visibility; then
    echo "gitinit: gh repo create failed; the local repo is intact at $target_dir." >&2
    echo "         fix the issue, then push with: git -C $target_dir push -u origin ${push_branches[*]}" >&2
    exit 1
  fi

  debug "git push -u origin ${push_branches[*]}"
  if ! git -C "$target_dir" push -u origin "${push_branches[@]}"; then
    echo "gitinit: push failed; the remote was created. Retry with:" >&2
    echo "         git -C $target_dir push -u origin ${push_branches[*]}" >&2
    exit 1
  fi
  debug "created and pushed ${create_owner}/${repo_name}"
fi

adopt_warning
